---
import { Database } from '@lucide/astro';
import SectionHeading from '@/components/SectionHeading.astro';
import angularLogo from 'devicon/icons/angular/angular-original.svg';
import astroLogo from 'devicon/icons/astro/astro-original.svg';
import azureLogo from 'devicon/icons/azure/azure-original.svg';
import azureDevopsLogo from 'devicon/icons/azuredevops/azuredevops-original.svg';
import blazorLogo from 'devicon/icons/blazor/blazor-original.svg';
import bootstrapLogo from 'devicon/icons/bootstrap/bootstrap-original.svg';
import claudeLogo from 'devicon/icons/claude/claude-original.svg';
import cloudflareLogo from 'devicon/icons/cloudflare/cloudflare-original.svg';
import codexLogo from 'devicon/icons/codex/codex-original.svg';
import csharpLogo from 'devicon/icons/csharp/csharp-original.svg';
import cppLogo from 'devicon/icons/cplusplus/cplusplus-original.svg';
import djangoLogo from 'devicon/icons/django/django-plain.svg';
import dockerLogo from 'devicon/icons/docker/docker-original.svg';
import dotnetCoreLogo from 'devicon/icons/dotnetcore/dotnetcore-original.svg';
import eclipseLogo from 'devicon/icons/eclipse/eclipse-original.svg';
import fastApiLogo from 'devicon/icons/fastapi/fastapi-original.svg';
import filezillaLogo from 'devicon/icons/filezilla/filezilla-original.svg';
import flaskLogo from 'devicon/icons/flask/flask-original.svg';
import gitLogo from 'devicon/icons/git/git-original.svg';
import githubLogo from 'devicon/icons/github/github-original.svg';
import githubActionsLogo from 'devicon/icons/githubactions/githubactions-original.svg';
import githubCopilotLogo from 'devicon/icons/githubcopilot/githubcopilot-original.svg';
import jiraLogo from 'devicon/icons/jira/jira-original.svg';
import javaLogo from 'devicon/icons/java/java-original.svg';
import javascriptLogo from 'devicon/icons/javascript/javascript-original.svg';
import jetbrainsLogo from 'devicon/icons/jetbrains/jetbrains-original.svg';
import latexLogo from 'devicon/icons/latex/latex-original.svg';
import linuxLogo from 'devicon/icons/linux/linux-original.svg';
import markdownLogo from 'devicon/icons/markdown/markdown-original.svg';
import microsoftSqlServerLogo from 'devicon/icons/microsoftsqlserver/microsoftsqlserver-original.svg';
import mongodbLogo from 'devicon/icons/mongodb/mongodb-original.svg';
import notionLogo from 'devicon/icons/notion/notion-original.svg';
import nodejsLogo from 'devicon/icons/nodejs/nodejs-original.svg';
import npmLogo from 'devicon/icons/npm/npm-original-wordmark.svg';
import nugetLogo from 'devicon/icons/nuget/nuget-original.svg';
import phpLogo from 'devicon/icons/php/php-original.svg';
import pnpmLogo from 'devicon/icons/pnpm/pnpm-original.svg';
import postgresqlLogo from 'devicon/icons/postgresql/postgresql-original.svg';
import postmanLogo from 'devicon/icons/postman/postman-original.svg';
import pypiLogo from 'devicon/icons/pypi/pypi-original.svg';
import pythonLogo from 'devicon/icons/python/python-original.svg';
import peopleSoftLogo from '@/assets/images/peoplesoft.svg';
import raspberryPiLogo from 'devicon/icons/raspberrypi/raspberrypi-original.svg';
import reactLogo from 'devicon/icons/react/react-original.svg';
import sqliteLogo from 'devicon/icons/sqlite/sqlite-original.svg';
import sshLogo from 'devicon/icons/ssh/ssh-original.svg';
import supabaseLogo from 'devicon/icons/supabase/supabase-original.svg';
import vimLogo from 'devicon/icons/vim/vim-original.svg';
import visualStudioLogo from 'devicon/icons/visualstudio/visualstudio-original.svg';
import vscodeLogo from 'devicon/icons/vscode/vscode-original.svg';
import xcodeLogo from 'devicon/icons/xcode/xcode-original.svg';
import xamarinLogo from 'devicon/icons/xamarin/xamarin-original.svg';

interface Props {
  class?: string;
  id?: string;
}

const { class: className = 'mt-14', id } = Astro.props;

const skills = [
  {
    label: 'Languages',
    items: [
      { label: 'Python', logo: pythonLogo },
      { label: 'C#', logo: csharpLogo },
      { label: 'Java', logo: javaLogo },
      { label: 'JavaScript', logo: javascriptLogo },
      { label: 'PeopleCode', logo: peopleSoftLogo },
      { label: 'C++', logo: cppLogo },
      { label: 'SQL', logo: Database },
      { label: 'PHP', logo: phpLogo },
    ],
  },
  {
    label: 'Frameworks',
    items: [
      { label: '.NET Core', logo: dotnetCoreLogo },
      { label: 'Xamarin', logo: xamarinLogo },
      { label: 'Angular', logo: angularLogo },
      { label: 'Astro', logo: astroLogo },
      { label: 'Blazor', logo: blazorLogo },
      { label: 'Bootstrap', logo: bootstrapLogo },
      { label: 'Django', logo: djangoLogo },
      { label: 'Flask', logo: flaskLogo },
      { label: 'Node.js', logo: nodejsLogo },
      { label: 'React', logo: reactLogo },
      { label: 'FastAPI', logo: fastApiLogo },
    ],
  },
  {
    label: 'Database',
    items: [
      { label: 'Microsoft SQL Server', logo: microsoftSqlServerLogo },
      { label: 'PostgreSQL', logo: postgresqlLogo },
      { label: 'SQLite', logo: sqliteLogo },
      { label: 'MongoDB', logo: mongodbLogo },
      { label: 'Supabase', logo: supabaseLogo },
    ],
  },
  {
    label: 'Cloud & DevOps',
    items: [
      { label: 'Azure', logo: azureLogo },
      { label: 'Azure DevOps', logo: azureDevopsLogo },
      { label: 'Git', logo: gitLogo },
      { label: 'GitHub', logo: githubLogo },
      { label: 'GitHub Actions', logo: githubActionsLogo },
      { label: 'Cloudflare', logo: cloudflareLogo },
      { label: 'Docker', logo: dockerLogo },
    ],
  },
  {
    label: 'IDEs',
    items: [
      { label: 'VS Code', logo: vscodeLogo },
      { label: 'Visual Studio', logo: visualStudioLogo },
      { label: 'Xcode', logo: xcodeLogo },
      { label: 'Eclipse', logo: eclipseLogo },
      { label: 'JetBrains', logo: jetbrainsLogo },
    ],
  },
  {
    label: 'AI Toolkit',
    items: [
      { label: 'Claude Code', logo: claudeLogo },
      { label: 'Codex', logo: codexLogo },
      { label: 'GitHub Copilot', logo: githubCopilotLogo },
    ],
  },
  {
    label: 'Package Managers',
    items: [
      { label: 'pnpm', logo: pnpmLogo },
      { label: 'npm', logo: npmLogo },
      { label: 'PyPI', logo: pypiLogo },
      { label: 'NuGet', logo: nugetLogo },
    ],
  },
  {
    label: 'Software',
    items: [
      { label: 'Jira', logo: jiraLogo },
      { label: 'Postman', logo: postmanLogo },
      { label: 'Notion', logo: notionLogo },
      { label: 'FileZilla', logo: filezillaLogo },
    ],
  },
  {
    label: 'Other Tools',
    items: [
      { label: 'Linux', logo: linuxLogo },
      { label: 'SSH', logo: sshLogo },
      { label: 'Raspberry Pi', logo: raspberryPiLogo },
      { label: 'Markdown', logo: markdownLogo },
      { label: 'Vim', logo: vimLogo },
      { label: 'LaTeX', logo: latexLogo },
    ],
  },
];
---

<section id={id} tabindex="-1" class={className}>
  <SectionHeading eyebrow="Tool Belt" />
  <div class="grid gap-3 sm:grid-cols-2">
    {skills.map((skill) => (
      <div class="skill-group border-line bg-surface rounded-2xl border p-5">
        <h3 class="text-ink font-display text-base font-medium">{skill.label}</h3>
        <ul class="mt-3 flex flex-wrap gap-2" aria-label={`${skill.label} skills`}>
          {skill.items.map((item) => {
            const Logo = item.logo;
            return (
              <li
                class:list={[
                  'border-line bg-surface hover:border-signal grid size-12 place-items-center rounded-xl border p-2 transition-colors',
                ]}
                title={item.label}
                aria-label={item.label}
              >
                {item.label === 'PeopleCode' ? (
                  <Logo class="size-7" aria-hidden="true" />
                ) : (
                  <Logo class="size-7" aria-hidden="true" />
                )}
                <span class="sr-only">{item.label}</span>
              </li>
            );
          })}
        </ul>
      </div>
    ))}
  </div>
</section>

<style>
  .skill-group {
    border-top: 2px solid color-mix(in srgb, var(--color-signal) 36%, var(--color-line));
  }

  .people-code-icon {
    background-color: white;
  }
</style>
