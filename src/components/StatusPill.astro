---
// src/components/StatusPills.astro
interface Props {
  latitude?: number;
  longitude?: number;
  timezone?: string;
  locationName?: string;
  statusText?: string;
}

const {
  latitude = 43.1594,
  longitude = -79.2469,
  timezone = "America/Toronto",
  locationName = "St. Catharines, ON",
  statusText = "Currently seeking my next role 🚀"
} = Astro.props;
---

<div class="status-container">
  <!-- Status Badge -->
  <div class="pill glow-green">
    <span class="pulsing-dot"></span>
    <span class="label">ACTIVE:</span>
    <span class="text">{statusText}</span>
  </div>

  <!-- Location & Weather Badge -->
  <div class="pill glow-red">
    <svg class="map-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
      <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
    </svg>
    <span class="loc-label">[LOC]</span>
    <span class="text">[{locationName}]</span>
    <span class="weather-time" id="weather-timestamp">(Loading...)</span>
  </div>
</div>

<script is:inline define:vars={{ latitude, longitude, timezone }}>
  const weatherCacheKey = `status-pill-weather-${latitude}-${longitude}`;
  const weatherCacheTtl = 10 * 60 * 1000;

  function getWeatherEmoji(code) {
  // Clear sky
  if (code === 0) return "☀️";

  // Mainly clear, partly cloudy, overcast
  if (code >= 1 && code <= 3) {
    if (code === 1) return "🌤️";
    if (code === 2) return "⛅";
    return "☁️";
  }

  // Fog & Depositing rime fog
  if (code === 45 || code === 48) return "🌫️";

  // Drizzle (Light, Moderate, Dense)
  if (code >= 51 && code <= 55) return "🌧️";

  // Freezing Drizzle
  if (code === 56 || code === 57) return "🥶🌧️";

  // Rain (Slight, Moderate, Heavy)
  if (code >= 61 && code <= 65) return "🌧️";

  // Freezing Rain
  if (code === 66 || code === 67) return "🧊🌧️";

  // Snow fall & Snow grains
  if ((code >= 71 && code <= 75) || code === 77) return "🌨️";

  // Rain showers
  if (code >= 80 && code <= 82) return "🌦️";

  // Snow showers
  if (code === 85 || code === 86) return "🌨️";

  // Thunderstorm
  if (code === 95) return "🌩️";

  // Thunderstorm with hail
  if (code === 96 || code === 99) return "⛈️";

  // Default fallback
  return "🌡️";
}
  function renderStatus(temperature, weatherCode) {
    const weatherEmoji = getWeatherEmoji(weatherCode);
    const localTime = new Date().toLocaleTimeString("en-US", {
      timeZone: timezone,
      hour: "numeric",
      minute: "2-digit",
      hour12: true,
    });
    const target = document.getElementById("weather-timestamp");

    if (target) {
      target.innerText = `(${temperature}°C ${weatherEmoji}, ${localTime})`;
    }
  }

  async function updateStatus() {
    let cachedStatus;

    try {
      cachedStatus = JSON.parse(sessionStorage.getItem(weatherCacheKey) || "null");
    } catch (error) {
      console.warn("Failed to read cached status widget data:", error);
    }

    if (cachedStatus) {
      renderStatus(cachedStatus.temperature, cachedStatus.weatherCode);
      if (Date.now() - cachedStatus.cachedAt < weatherCacheTtl) {
        return;
      }
    }

    try {
      const response = await fetch(
        `https://api.open-meteo.com/v1/forecast?latitude=${latitude}&longitude=${longitude}&current=temperature_2m,weather_code&temperature_unit=celsius`
      );
      if (!response.ok) {
        throw new Error(`Weather request failed with status ${response.status}`);
      }

      const data = await response.json();
      const status = {
        temperature: Math.round(data.current.temperature_2m),
        weatherCode: data.current.weather_code,
        cachedAt: Date.now(),
      };

      renderStatus(status.temperature, status.weatherCode);
      try {
        sessionStorage.setItem(weatherCacheKey, JSON.stringify(status));
      } catch (error) {
        console.warn("Failed to cache status widget data:", error);
      }
    } catch (error) {
      console.error("Failed to load status widget data:", error);
      if (!cachedStatus) {
        const target = document.getElementById("weather-timestamp");
        if (target) {
          target.innerText = "(Weather unavailable)";
        }
      }
    }
  }

  document.addEventListener("astro:page-load", updateStatus);
  updateStatus();
</script>

<style>
  .status-container {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.875rem;
  }

  .pill {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.85rem;
    border-radius: 9999px;
    background: var(--surface);
    color: var(--ink);
    border: 1px solid var(--line);
    transition: border-color 0.3s ease, box-shadow 0.3s ease, background-color 0.3s ease;
  }

  /* Green Glow Pill */
  .glow-green {
    border-color: #22c55e;
    box-shadow: 0 0 10px rgba(34, 197, 94, 0.25);
  }
  .glow-green:hover {
    box-shadow: 0 0 16px rgba(34, 197, 94, 0.45);
  }

  /* Red Glow Pill */
  .glow-red {
    border-color: #ef4444;
    box-shadow: 0 0 10px rgba(239, 68, 68, 0.25);
  }
  .glow-red:hover {
    box-shadow: 0 0 16px rgba(239, 68, 68, 0.45);
  }

  /* Pulsing Green Dot */
  .pulsing-dot {
    width: 8px;
    height: 8px;
    background-color: #22c55e;
    border-radius: 50%;
    box-shadow: 0 0 6px #22c55e;
    animation: pulse 2s infinite;
  }

  @keyframes pulse {
    0% {
      transform: scale(0.95);
      box-shadow: 0 0 0 0 rgba(34, 197, 94, 0.7);
    }
    70% {
      transform: scale(1);
      box-shadow: 0 0 0 6px rgba(34, 197, 94, 0);
    }
    100% {
      transform: scale(0.95);
      box-shadow: 0 0 0 0 rgba(34, 197, 94, 0);
    }
  }

  /* Map Pin Icon */
  .map-icon {
    width: 1rem;
    height: 1rem;
    color: #ef4444;
    filter: drop-shadow(0 0 3px rgba(239, 68, 68, 0.5));
  }

  /* Text Elements using Theme Variables */
  .label {
    color: #16a34a; /* Slightly darker green in light mode for readability */
    font-weight: 600;
  }

  .loc-label {
    color: #dc2626; /* Slightly darker red in light mode for readability */
    font-weight: 600;
  }

  .text {
    color: var(--ink);
  }

  .weather-time {
    color: var(--ink-soft);
  }

  /* Optional Dark Mode Adjustments for High-Contrast Accents */
  @media (prefers-color-scheme: dark) {
    .label {
      color: #4ade80;
    }
    .loc-label {
      color: #f87171;
    }
  }
</style>