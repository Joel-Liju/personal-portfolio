---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/Button.astro';
---

<BaseLayout title="Page not found">
  <section class="error-page mx-auto grid max-w-5xl items-center gap-12 px-6 py-20 md:grid-cols-[1fr_0.85fr] md:gap-16 md:py-28">
    <div class="error-copy">
      <p class="text-ink-soft mb-6 font-mono text-xs tracking-[0.2em] uppercase">404 · Lost a turn</p>
      <h1 class="font-display text-ink max-w-xl text-4xl leading-tight font-medium sm:text-6xl">
        Looks like you took a wrong turn.
      </h1>
      <p class="text-ink-soft mt-5 max-w-md text-lg leading-relaxed">
        This page isn't on the board. Let's get you back in the game.
      </p>
      <div class="mt-8 flex flex-wrap items-center gap-3">
        <Button href="/" variant="solid">Back to home <span aria-hidden="true">→</span></Button>
        <a
          href="/hobbies"
          class="inline-flex items-center gap-2 rounded-full border border-line px-5 py-2.5 text-sm font-medium text-ink transition-colors hover:border-signal hover:text-signal"
          data-random-destination
        >
          Explore hobbies →
        </a>
      </div>
    </div>

    <div class="game-board" data-destination-board aria-hidden="true">
      <div class="board-topline">
        <span>THE DETOUR</span>
        <span data-destination-category>404 / LOST</span>
      </div>
      <div class="board-grid">
        <div class="board-tile board-tile--start"><span>START</span><span>01</span></div>
        <div class="board-tile"><span>02</span></div>
        <div class="board-tile board-tile--marked"><span>03</span><span class="pawn">♟</span></div>
        <div class="board-tile"><span>05</span></div>
        <div class="board-tile board-tile--lost">
          <span data-destination-label>OH NO</span>
          <strong data-destination-icon>404</strong>
        </div>
        <div class="board-tile"><span>04</span></div>
        <div class="board-tile"><span>06</span></div>
        <div class="board-tile"><span>07</span></div>
        <div class="board-tile board-tile--finish">
          <span data-destination-short>HOME</span>
          <span>→</span>
        </div>
      </div>
      <p class="board-caption" data-destination-caption>A small detour. No points deducted.</p>
    </div>
  </section>
</BaseLayout>

<script>
  const destinations = [
    {
      href: '/work',
      label: 'selected work',
      category: 'BUILD',
      short: 'WORK',
      icon: '✦',
      theme: 'work',
    },
    {
      href: '/hobbies/board-games',
      label: 'board games',
      category: 'GAME NIGHT',
      short: 'PLAY',
      icon: '♟',
      theme: 'games',
    },
    {
      href: '/hobbies/food',
      label: 'recipes',
      category: 'COOKING',
      short: 'BAKE',
      icon: '♨',
      theme: 'recipes',
    },
    {
      href: '/hobbies/wine',
      label: 'wine notes',
      category: 'TASTING NOTES',
      short: 'SIP',
      icon: '✳',
      theme: 'wine',
    },
    {
      href: '/about',
      label: 'about me',
      category: 'A LITTLE ABOUT ME',
      short: 'MEET',
      icon: '☺',
      theme: 'about',
    },
  ] as const;

  const destinationLink = document.querySelector<HTMLAnchorElement>('[data-random-destination]');
  const board = document.querySelector<HTMLElement>('[data-destination-board]');
  const category = board?.querySelector<HTMLElement>('[data-destination-category]');
  const label = board?.querySelector<HTMLElement>('[data-destination-label]');
  const icon = board?.querySelector<HTMLElement>('[data-destination-icon]');
  const short = board?.querySelector<HTMLElement>('[data-destination-short]');
  const caption = board?.querySelector<HTMLElement>('[data-destination-caption]');

  if (!destinationLink || !board || !category || !label || !icon || !short || !caption) {
    throw new Error('404 destination guide is missing required elements.');
  }

  const destination = destinations[Math.floor(Math.random() * destinations.length)];
  destinationLink.href = destination.href;
  destinationLink.textContent = `Try ${destination.label} →`;
  category.textContent = destination.category;
  label.textContent = 'NEXT UP';
  icon.textContent = destination.icon;
  short.textContent = destination.short;
  caption.textContent = `Your next stop: ${destination.label}.`;
  board.dataset.theme = destination.theme;
</script>

<style>
  .game-board {
    width: min(100%, 27rem);
    justify-self: center;
    padding: clamp(1rem, 4vw, 1.5rem);
    border: 1px solid var(--color-line);
    border-radius: 1.25rem;
    background: color-mix(in srgb, var(--color-surface) 84%, transparent);
    box-shadow: 0 1rem 3rem color-mix(in srgb, var(--color-ink) 8%, transparent);
    transform: rotate(2deg);
  }

  .board-topline {
    display: flex;
    justify-content: space-between;
    margin-bottom: 0.75rem;
    color: var(--color-ink-soft);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.14em;
  }

  .board-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.5rem;
  }

  .board-tile {
    position: relative;
    display: flex;
    aspect-ratio: 1;
    flex-direction: column;
    justify-content: space-between;
    padding: 0.65rem;
    border: 1px solid var(--color-line);
    border-radius: 0.75rem;
    background: var(--color-paper);
    color: var(--color-ink-soft);
    font-family: var(--font-mono);
    font-size: 0.625rem;
  }

  .board-tile--start,
  .board-tile--finish {
    background: color-mix(in srgb, var(--color-signal) 12%, var(--color-paper));
    color: var(--color-signal);
  }

  .board-tile--lost {
    align-items: center;
    justify-content: center;
    gap: 0.1rem;
    background: var(--color-signal);
    color: var(--color-paper);
    transform: rotate(-4deg) scale(1.04);
  }

  .board-tile--lost strong {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 7vw, 2.5rem);
    font-weight: 500;
    line-height: 1;
  }

  .game-board[data-theme='work'] .board-tile--lost {
    border-radius: 0.25rem;
  }

  .game-board[data-theme='games'] .board-tile--lost {
    transform: rotate(-8deg) scale(1.04);
  }

  .game-board[data-theme='recipes'] .board-tile--lost {
    border-radius: 50%;
  }

  .game-board[data-theme='wine'] .board-tile--lost {
    border-radius: 50% 50% 0.75rem 0.75rem;
  }

  .game-board[data-theme='about'] .board-tile--lost {
    border-radius: 50%;
    background: var(--color-paper);
    color: var(--color-signal);
  }

  .board-tile--marked {
    border-style: dashed;
  }

  .pawn {
    position: absolute;
    right: 0.5rem;
    bottom: 0.45rem;
    color: var(--color-signal);
    font-size: 1.5rem;
    animation: pawn-hop 1.8s ease-in-out infinite;
  }

  .board-caption {
    margin: 0.9rem 0 0;
    color: var(--color-ink-soft);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    text-align: center;
  }

  @keyframes pawn-hop {
    0%,
    100% {
      transform: translateY(0) rotate(0);
    }
    50% {
      transform: translateY(-0.3rem) rotate(8deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pawn {
      animation: none;
    }
  }
</style>
