---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import WorkRow from '@/components/WorkRow.astro';
import SectionHeading from '@/components/SectionHeading.astro';

const allRecipes = (await getCollection('recipes', ({ data }) => !data.draft)).sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);
---

<BaseLayout
  title="Recipes"
  description="A collection of my favorite recipes."
>
  <section class="mx-auto max-w-5xl px-6 pt-16 pb-24 sm:pt-24">
    <SectionHeading eyebrow="All recipes" count={allRecipes.length} />
    <div>
      {allRecipes.map((entry) => <WorkRow entry={entry} />)}
    </div>
  </section>
</BaseLayout>
