---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { formatDate } from '@/utils/formatDate';

export async function getStaticPaths() {
  const wines = await getCollection('wines', ({ data }) => !data.draft);
  return wines.map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'wines'>;
}

const { entry } = Astro.props;
const { title, summary, date, producer, varietal, region, vintage, rating, tags, url } = entry.data;
const { Content, headings } = await render(entry);
---

<BaseLayout title={title} description={summary}>
  <article class="mx-auto max-w-5xl px-6 pt-16 pb-24 sm:pt-24">
    <a
      href="/hobbies/wine"
      class="text-ink-soft hover:text-signal font-mono text-xs transition-colors"
    >
      ← All wine notes
    </a>

    <p class="text-ink-soft mt-8 font-mono text-xs tracking-[0.2em] uppercase">Wine note</p>
    <h1 class="font-display text-ink mt-3 max-w-2xl text-4xl font-medium sm:text-5xl">{title}</h1>
    <p class="text-ink-soft mt-4 max-w-2xl leading-relaxed">{summary}</p>

    <dl class="border-line mt-8 grid grid-cols-2 gap-px overflow-hidden rounded-2xl border bg-line sm:grid-cols-3">
      <div class="bg-surface px-4 py-4 sm:px-5">
        <dt class="text-ink-soft font-mono text-[11px] uppercase tracking-wide">Producer</dt>
        <dd class="font-display text-ink mt-1 text-lg">{producer}</dd>
      </div>
      <div class="bg-surface px-4 py-4 sm:px-5">
        <dt class="text-ink-soft font-mono text-[11px] uppercase tracking-wide">Varietal</dt>
        <dd class="font-display text-ink mt-1 text-lg">{varietal}</dd>
      </div>
      <div class="bg-surface px-4 py-4 sm:px-5">
        <dt class="text-ink-soft font-mono text-[11px] uppercase tracking-wide">Region</dt>
        <dd class="font-display text-ink mt-1 text-lg">{region}</dd>
      </div>
      {vintage && (
        <div class="bg-surface px-4 py-4 sm:px-5">
          <dt class="text-ink-soft font-mono text-[11px] uppercase tracking-wide">Vintage</dt>
          <dd class="font-display text-ink mt-1 text-lg">{vintage}</dd>
        </div>
      )}
      {typeof rating === 'number' && (
        <div class="bg-surface px-4 py-4 sm:px-5">
          <dt class="text-ink-soft font-mono text-[11px] uppercase tracking-wide">Rating</dt>
          <dd class="font-display text-ink mt-1 text-lg">{rating}/5</dd>
        </div>
      )}
      <div class="bg-surface px-4 py-4 sm:px-5">
        <dt class="text-ink-soft font-mono text-[11px] uppercase tracking-wide">Tasted</dt>
        <dd class="font-display text-ink mt-1 text-lg">{formatDate(date)}</dd>
      </div>
    </dl>

    {tags.length > 0 && (
      <ul class="mt-4 flex flex-wrap gap-2" aria-label="Wine tags">
        {tags.map((tag) => (
          <li class="border-line text-ink-soft rounded-full border bg-surface/70 px-3 py-1 font-mono text-[11px]">
            {tag}
          </li>
        ))}
      </ul>
    )}

    {headings.length > 0 && (
      <nav class="mt-8" aria-label="Page sections">
        <ul class="flex flex-wrap gap-2">
          {headings.map((heading) => (
            <li>
              <a
                href={`#${heading.slug}`}
                class="border-line text-ink-soft hover:border-signal hover:text-signal inline-flex rounded-full border px-3 py-2 font-mono text-xs transition-colors"
              >
                {heading.text}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )}

    <div class="prose prose-sm sm:prose-base mt-10 max-w-3xl">
      <Content />
    </div>

    {
      url && (
        <a
          href={url}
          target="_blank"
          rel="noreferrer"
          class="text-signal mt-10 inline-flex font-mono text-xs hover:underline"
        >
          More about this wine →
        </a>
      )
    }
  </article>
</BaseLayout>
