---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { formatDate } from '@/utils/formatDate';

export async function getStaticPaths() {
  const wines = await getCollection('wines', ({ data }) => !data.draft);
  return wines.map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'wines'>;
}

const { entry } = Astro.props;
const { title, summary, date, producer, varietal, region, vintage, rating, tags, url } = entry.data;
const { Content } = await render(entry);
---

<BaseLayout title={title} description={summary}>
  <article class="mx-auto max-w-5xl px-6 pt-16 pb-24 sm:pt-24">
    <a
      href="/hobbies/wine"
      class="text-ink-soft hover:text-signal font-mono text-xs transition-colors"
    >
      ← All wine notes
    </a>

    <p class="text-ink-soft mt-8 font-mono text-xs tracking-[0.2em] uppercase">Wine note</p>
    <h1 class="font-display text-ink mt-3 max-w-2xl text-4xl font-medium sm:text-5xl">{title}</h1>
    <p class="text-ink-soft mt-4 max-w-2xl leading-relaxed">{summary}</p>

    <dl
      class="border-line text-ink-soft mt-8 flex flex-wrap gap-x-8 gap-y-3 border-y py-4 font-mono text-xs"
    >
      <div><dt class="inline">Producer — </dt><dd class="inline">{producer}</dd></div>
      <div><dt class="inline">Varietal — </dt><dd class="inline">{varietal}</dd></div>
      <div><dt class="inline">Region — </dt><dd class="inline">{region}</dd></div>
      {
        vintage && (
          <div>
            <>
              <dt class="inline">Vintage — </dt>
              <dd class="inline">{vintage}</dd>
            </>
          </div>
        )
      }
      {
        typeof rating === 'number' && (
          <div>
            <>
              <dt class="inline">Rating — </dt>
              <dd class="inline">{rating}/5</dd>
            </>
          </div>
        )
      }
      <div><dt class="inline">Tasted — </dt><dd class="inline">{formatDate(date)}</dd></div>
      {
        tags.length > 0 && (
          <div>
            <dt class="inline">Tags — </dt>
            <dd class="inline">{tags.join(', ')}</dd>
          </div>
        )
      }
    </dl>

    <div class="prose prose-sm sm:prose-base mt-10 max-w-2xl">
      <Content />
    </div>

    {
      url && (
        <a
          href={url}
          target="_blank"
          rel="noreferrer"
          class="text-signal mt-10 inline-flex font-mono text-xs hover:underline"
        >
          More about this wine →
        </a>
      )
    }
  </article>
</BaseLayout>
