---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { BriefcaseBusiness, CodeXml, Mail } from '@lucide/astro';
import { SITE } from '@/site.config';

const contactMethods = [
  { label: 'Email', href: `mailto:${SITE.email}`, Icon: Mail },
  ...SITE.social.map(({ label, href }) => ({
    label,
    href,
    Icon: label === 'GitHub' ? CodeXml : BriefcaseBusiness,
  })),
];

---

<BaseLayout title="Contact" description={`Get in touch with ${SITE.name}.`}>
  <section class="mx-auto max-w-5xl px-6 pt-16 pb-24 sm:pt-24">
    <p class="text-ink-soft mb-6 font-mono text-xs tracking-[0.2em] uppercase">Contact</p>

    <h1 class="font-display text-ink max-w-xl text-3xl font-medium sm:text-4xl">
      Get in touch with me. Here are some ways to reach out.
    </h1>

    <div class="mt-12 flex max-w-2xl flex-col gap-3">
      {contactMethods.map(({ label, href, Icon }) => (
        <a
          class="group flex min-h-16 items-center justify-between gap-4 rounded-full border border-line bg-surface px-6 py-4 text-ink transition-colors duration-300 hover:border-signal hover:bg-signal hover:text-paper focus-visible:bg-signal focus-visible:text-paper"
          href={href}
          target={label === 'Email' ? undefined : '_blank'}
          rel={label === 'Email' ? undefined : 'noreferrer'}
        >
          <span class="flex items-center gap-3">
            <span class="grid size-10 shrink-0 place-items-center rounded-full bg-paper text-signal transition-colors duration-300 group-hover:bg-paper/20 group-hover:text-paper group-focus-visible:bg-paper/20 group-focus-visible:text-paper">
              <Icon aria-hidden="true" size={18} stroke-width={1.8} />
            </span>
            <span class="font-display text-lg font-medium">{label}</span>
          </span>
          <span aria-hidden="true" class="shrink-0 text-lg transition-transform duration-300 group-hover:translate-x-1">↗</span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
