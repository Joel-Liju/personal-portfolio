---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/Button.astro';
import { SITE } from '@/site.config';

const tools = ['C#', '.NET', 'Java', 'Python', 'JavaScript', 'React', 'SQL', 'Docker'];
---

<BaseLayout title="About" description={`A bit about ${SITE.name} and how they work.`}>
  <section class="mx-auto max-w-5xl px-6 pt-16 pb-24 sm:pt-24">
    <p class="text-ink-soft mb-6 font-mono text-xs tracking-[0.2em] uppercase">About</p>

    <h1 class="font-display text-ink max-w-xl text-3xl font-medium sm:text-4xl">
      Software Engineer.
    </h1>

    <div class="prose prose-sm sm:prose-base mt-8 max-w-xl">
      <p>
        I'm Joel — I build software that people actually use.
      </p>
      <p>
        For the last three years I was a Programmer Analyst at Niagara College, building and
        maintaining the tools students, advisors, and enrolment staff use to track degree progress.
        I automated reporting that used to take two weeks down to a few minutes, and standardized
        our CI/CD pipeline so staging deploys land in under fifteen minutes.
      </p>
      <p>
        Before that: software co-ops at Ontario's Ministry of Transportation, a computer science
        degree from Brock (with a few Dean's Honour List appearances), and a stint as a McDonald's
        team lead — which taught me more about performing under pressure than any sprint retro ever did.
      </p>
      <p>
        Day to day I work in C#/.NET, Java, Python, and React, with Docker and Azure Pipelines
        keeping everything honest. Python doubles as my side-gig language, and I tinker with machine
        learning and computer graphics in the hours I probably should be sleeping.
      </p>
      <p>
        Right now I'm between roles and looking for my next software engineering gig — ideally
        somewhere I can keep building things people rely on.
      </p>
    </div>

    <div class="mt-10">
      <p class="text-ink-soft mb-3 font-mono text-xs tracking-[0.2em] uppercase">Tools</p>
      <ul class="flex flex-wrap gap-2">
        {
          tools.map((tool) => (
            <li class="border-line text-ink-soft rounded-full border px-3 py-1 font-mono text-xs">
              {tool}
            </li>
          ))
        }
      </ul>
    </div>

    <Button href={`mailto:${SITE.email}`} class="mt-10">Get in touch</Button>
  </section>
</BaseLayout>
