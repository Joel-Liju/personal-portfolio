---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/Button.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import Skills from '@/components/Skills.astro';
import { SITE } from '@/site.config';

const experience = [
  {
    title: 'Independent Developer',
    details: 'Jul 2026 – Present (relocated to India)',
    bullets: [
      'Designed and built the English/Arabic website for Topline, a UAE HVAC contractor, using Astro (toplinemep.ae).',
      'Built and maintain my portfolio site with project case studies (joellijujacob.com).',
    ],
  },
  {
    title: 'Programmer Analyst — Niagara College (ESS)',
    details: 'Welland, ON · Jul 2023 – Jun 2026',
    bullets: [
      'Built the Niagara Career Fair registration system in C#, Blazor (.NET 10) and SQL Server, with an organizer dashboard tracking registrations, attendance, food requests and fundraising.',
      'Developed, debugged, and maintained automated reporting scripts for 4 departments (ITS, Enrolment, Finance, HR), cutting a manual reporting cycle of nearly 2 weeks down to a few minutes.',
      'Architected a standardized CI/CD pipeline for the test environment, replacing a manual email-based approval chain that took 30 minutes to 2 days with one-click approvals, cutting staging deployment times to under 15 minutes.',
      'Collaborated across business and tech teams to gather requirements and define clear acceptance criteria, consistently closing 20% more tickets per sprint than the team average.',
    ],
  },
  {
    title: 'Junior Developer (Co-op) — Digital Garage, MTO',
    details: 'St. Catharines, ON · May 2022 – Aug 2022',
    bullets: [
      'Delivered full-stack features for an internal web application using C#, React, and SQL in an Agile team; refactored repeated logic into shared functions and split overbloated functions into focused components to improve maintainability across the site.',
      'Prototyped an automated Azure-based virus-scanning API for the data-ingestion pipeline, mitigating vulnerabilities from uploaded documents.',
      'Built a decentralized application prototype using Solidity and Truffle, evaluating blockchain ledger immutability for task-state management.',
      'Researched QA testing by developing automated test scripts in Katalon.',
    ],
  },
  {
    title: 'Junior Technical Analyst (Co-op) — MTO',
    details: 'St. Catharines, ON · Jun 2020 – Aug 2020',
    bullets: [
      'Optimized Azure cloud governance by analyzing, auditing, and restructuring tagging schemas across resource groups to map asset utilization.',
      'Facilitated cross-functional meetings to present technical findings, securing stakeholder consensus to decommission redundant cloud resources.',
      'Audited and eliminated unneeded infrastructure, reducing Azure subscription costs by 38% in the primary environment and 18% in the secondary.',
    ],
  },
];

const projects = [
  {
    title: 'Capstone — CI/CD Microservice Deployment (Apr 2022)',
    description:
      'Automated CI/CD pipelines with Docker and GitHub Actions to containerize and deploy microservices to Heroku, minimizing environment drift; built data-cleaning workflows turning unstructured campus/event data into standardized, AI-ready datasets; ran system-integration testing across git workflows for stable releases.',
  },
  {
    title: 'Document Reconstruction Engine — Genetic Algorithm (Mar 2020)',
    description:
      'Designed a structural reconstruction system using genetic algorithms to solve shredded-document reordering; compared three crossover models (Order, PMX, Alternative Position) in Python (Pandas) and Java, with quantitative analysis synthesized into a technical whitepaper.',
  },
];

const leadership = [
  {
    title: 'Computer Science Club President (2020–2021)',
    description:
      'led coordination between club executives and external stakeholders to plan, scope, and deploy hybrid workshops; managed end-to-end event lifecycles and scaled a recurring workshop framework delivering technical training to a diverse student body.',
  },
  {
    title: 'International Collegiate Programming Contest (2021)',
    description:
      'analyzed complex logic problems in a high-pressure team setting, designing optimized algorithmic solutions under strict runtime and data constraints.',
  },
];

const additionalExperience = [
  {
    title: 'Drop-in Tutor, Brock University (2022–2023)',
    description:
      'translated complex CS concepts into accessible lessons for a diverse student body; designed and delivered a structured C++ curriculum covering foundational object-oriented programming and system logic.',
  },
  {
    title: "Crew / Team Lead, McDonald's (2019–2023)",
    description:
      'led kitchen operations and cross-functional teams under high-pressure conditions; awarded Employee of the Year.',
  },
];

const volunteerWork = [
  {
    title: 'Church Volunteer, St. Catharines (2019–2026)',
    description:
      'run graphics, lighting, and audio for weekly services; assist with setup and teardown of the sanctuary; lead a weekly young-adults scripture group.',
  },
  {
    title: 'Canada Games 2022 Niagara (Aug 2022)',
    description:
      'provided tech support resolving technical issues during events, and served as a food provisioner coordinating meals for volunteers.',
  },
];

type Credential = {
  title: string;
  issuer: string;
  kind: 'Badge' | 'Certificate';
  issued?: string;
  verificationUrl?: string;
  pdfUrl?: string;
};

const credentials: Credential[] = [
  {
    title: 'Claude 101',
    issuer: 'Claude Academy',
    kind: 'Badge',
    issued: 'Nov 13, 2026',
    verificationUrl: 'https://academy.claude.com/verify/06c1a1efc750851ff1a1b7a0582ff00a',
  },
  {
    title: 'Claude Platform 101',
    issuer: 'Claude Academy',
    kind: 'Badge',
    issued: 'Nov 15, 2026',
    verificationUrl: 'https://academy.claude.com/verify/e89de691728c466c4d51dc0da793657b',
  },
];

const resumeSections = [
  { id: 'resume-overview', label: 'Overview' },
  { id: 'resume-skills', label: 'Tool Belt' },
  { id: 'resume-experience', label: 'Experience' },
  { id: 'resume-projects', label: 'Projects' },
  { id: 'resume-education', label: 'Education' },
  { id: 'resume-credentials', label: 'Certificates & Badges' },
  { id: 'resume-leadership', label: 'Leadership' },
  { id: 'resume-additional', label: 'Additional' },
  { id: 'resume-volunteer', label: 'Volunteer' }
];
---

<BaseLayout
  title="Resume"
  description={`Resume for ${SITE.name}, Software Engineer.`}
>
  <article class="resume-page mx-auto max-w-5xl px-6 pt-12 pb-24 sm:pt-20">
    <header id="resume-overview" tabindex="-1" class="resume-intro border-line bg-surface rounded-3xl border p-6 shadow-sm sm:p-10">
      <div class="flex flex-col gap-8 sm:flex-row sm:items-start sm:justify-between">
        <div class="max-w-2xl">
          <p class="text-signal mb-4 font-mono text-xs tracking-[0.2em] uppercase">Resume</p>
          <h1 class="font-display text-ink text-4xl font-medium sm:text-6xl">{SITE.name}</h1>
          <p class="text-signal mt-2 font-display text-xl sm:text-2xl">Software Engineer</p>
          <p class="text-ink-soft mt-6 max-w-2xl leading-relaxed">
            Software Engineer with 3 years of experience building backend and full-stack systems,
            including C#/.NET applications on ASP.NET Core (Blazor) with SQL Server. Cut staging
            deployment time to under 15 minutes with a standardized CI/CD pipeline and automated
            reporting for 4 departments. Immediate joiner, open to relocation across India.
          </p>
        </div>
        <div class="flex shrink-0 flex-wrap gap-3">
          <Button href="/resume.pdf">Download PDF <span aria-hidden="true">↓</span></Button>
        </div>
      </div>

      <div class="border-line text-ink-soft mt-8 flex flex-wrap gap-x-5 gap-y-2 border-t pt-5 font-mono text-xs">
        <span>Kottayam, Kerala</span>
        <a class="hover:text-signal transition-colors" href={`mailto:${SITE.email}`}><!--email_off-->{SITE.email}<!--/email_off--></a>
        <a class="hover:text-signal transition-colors" href="tel:+919544759865">+91 95447 59865</a>
        <a class="hover:text-signal transition-colors" href={SITE.social[1].href}>GitHub</a>
        <a class="hover:text-signal transition-colors" href={SITE.social[2].href}>LinkedIn</a>
      </div>
    </header>

    <nav class="resume-section-rail" aria-label="Resume sections">
      <p class="resume-section-label">On this page</p>
      <ol>
        {
          resumeSections.map((section) => (
            <li>
              <a
                href={`#${section.id}`}
                data-section-link={section.id}
                data-section-label={section.label}
              >
                {section.label}
              </a>
            </li>
          ))
        }
      </ol>
    </nav>

    <details class="resume-section-menu">
      <summary>
        <span>Jump to</span>
        <span data-current-section>Overview</span>
        <svg aria-hidden="true" viewBox="0 0 16 16" fill="none">
          <path d="m4 6 4 4 4-4"></path>
        </svg>
      </summary>
      <nav aria-label="Resume sections">
        <ol>
          {
            resumeSections.map((section) => (
              <li>
                <a
                  href={`#${section.id}`}
                  data-section-link={section.id}
                  data-section-label={section.label}
                >
                  {section.label}
                </a>
              </li>
            ))
          }
        </ol>
      </nav>
    </details>

    <Skills id="resume-skills" />

    <section id="resume-experience" tabindex="-1" class="mt-14">
      <SectionHeading eyebrow="Experience" />
      <div class="space-y-4">
        {experience.map((job) => (
          <article class:list={["resume-role border-line bg-surface rounded-2xl border p-5 sm:p-7", { "resume-role-featured": experience.indexOf(job) === 0 }]}>
            <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between sm:gap-4">
              <h3 class="font-display text-ink text-lg font-medium sm:text-xl">{job.title}</h3>
              <p class="resume-date text-ink-soft shrink-0 font-mono text-xs">{job.details}</p>
            </div>
            <ul class="text-ink-soft mt-4 space-y-2 text-sm leading-relaxed">
              {job.bullets.map((bullet) => <li class="flex gap-3"><span class="text-signal">•</span><span>{bullet}</span></li>)}
            </ul>
          </article>
        ))}
      </div>
    </section>

    <section id="resume-projects" tabindex="-1" class="mt-14">
      <SectionHeading eyebrow="Academic Projects" />
      <div class="grid gap-4 md:grid-cols-2">
        {projects.map((project) => (
          <article class="border-line bg-surface rounded-2xl border p-5 sm:p-7">
            <h3 class="font-display text-ink text-lg font-medium">{project.title}</h3>
            <p class="text-ink-soft mt-3 text-sm leading-relaxed">{project.description}</p>
          </article>
        ))}
      </div>
    </section>

    <section id="resume-education" tabindex="-1" class="mt-14">
      <SectionHeading eyebrow="Education" />
      <div class="resume-education border-line bg-surface rounded-2xl border p-5 sm:p-7">
        <h3 class="font-display text-ink text-lg font-medium">Brock University</h3>
        <p class="text-ink-soft mt-2 text-sm leading-relaxed">
          Honours B.Sc. Computer Science, Minor in Economics, Jan 2019 – Jan 2023. Dean's Honour
          List (years 1, 2, and 3).
        </p>
      </div>
    </section>

    <section id="resume-credentials" tabindex="-1" class="mt-14">
      <SectionHeading eyebrow="Certificates & Badges" count={credentials.length} />
      <div class="grid gap-4 md:grid-cols-2">
        {credentials.map((credential) => (
          <article class="resume-credential border-line bg-surface rounded-2xl border p-5 sm:p-6">
            <div class="flex items-start gap-4">
              <span class="resume-credential-mark grid size-12 shrink-0 place-items-center rounded-xl">
                <svg
                  aria-hidden="true"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="size-6"
                >
                  <path d="M8 3.75h8l1.25 4.5-5.25 3.5-5.25-3.5L8 3.75Z" />
                  <path d="m8.6 10.1-1 9.15 4.4-2.5 4.4 2.5-1-9.15M10 6.75h4" />
                </svg>
              </span>
              <div class="min-w-0 flex-1">
                <p class="text-signal font-mono text-[0.625rem] tracking-[0.16em] uppercase">
                  {credential.kind}
                </p>
                <h3 class="font-display text-ink mt-1 text-lg font-medium">
                  {credential.title}
                </h3>
                <p class="text-ink-soft mt-1 text-sm">
                  {credential.issuer}
                  {credential.issued && <> · {credential.issued}</>}
                </p>
              </div>
            </div>
            {(credential.verificationUrl || credential.pdfUrl) && (
              <div class="mt-5 flex flex-wrap gap-2 border-t border-line pt-4">
                {credential.verificationUrl && (
                  <a
                    class="border-line text-ink-soft hover:border-signal hover:text-signal inline-flex items-center gap-2 rounded-full border px-3 py-2 font-mono text-[0.625rem] tracking-wide uppercase transition-colors"
                    href={credential.verificationUrl}
                    target="_blank"
                    rel="noreferrer"
                  >
                    Verify badge <span aria-hidden="true">↗</span>
                  </a>
                )}
                {credential.pdfUrl && (
                  <a
                    class="border-line text-ink-soft hover:border-signal hover:text-signal inline-flex items-center gap-2 rounded-full border px-3 py-2 font-mono text-[0.625rem] tracking-wide uppercase transition-colors"
                    href={credential.pdfUrl}
                    target="_blank"
                    rel="noreferrer"
                  >
                    View PDF <span aria-hidden="true">↗</span>
                  </a>
                )}
              </div>
            )}
          </article>
        ))}
      </div>
    </section>

    <section id="resume-leadership" tabindex="-1" class="mt-14">
      <SectionHeading eyebrow="Extracurricular & Leadership" />
      <div class="grid gap-4 md:grid-cols-2">
        {leadership.map((item) => (
          <article class="border-line bg-surface rounded-2xl border p-5 sm:p-7">
            <h3 class="font-display text-ink text-lg font-medium">{item.title}</h3>
            <p class="text-ink-soft mt-3 text-sm leading-relaxed">{item.description}</p>
          </article>
        ))}
      </div>
    </section>

    <section id="resume-additional" tabindex="-1" class="mt-14">
      <SectionHeading eyebrow="Additional Experience" />
      <div class="grid gap-4 md:grid-cols-2">
        {additionalExperience.map((item) => (
          <article class="border-line bg-surface rounded-2xl border p-5 sm:p-7">
            <h3 class="font-display text-ink text-lg font-medium">{item.title}</h3>
            <p class="text-ink-soft mt-3 text-sm leading-relaxed">{item.description}</p>
          </article>
        ))}
      </div>
    </section>

    <section id="resume-volunteer" tabindex="-1" class="mt-14">
      <SectionHeading eyebrow="Volunteer Work" />
      <div class="grid gap-4 md:grid-cols-2">
        {volunteerWork.map((item) => (
          <article class="border-line bg-surface rounded-2xl border p-5 sm:p-7">
            <h3 class="font-display text-ink text-lg font-medium">{item.title}</h3>
            <p class="text-ink-soft mt-3 text-sm leading-relaxed">{item.description}</p>
          </article>
        ))}
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .resume-intro {
    background-image: linear-gradient(135deg, color-mix(in srgb, var(--color-signal) 7%, var(--color-surface)), var(--color-surface) 58%);
  }

  .resume-section-rail {
    position: fixed;
    z-index: 20;
    top: 50%;
    left: max(1rem, calc((100vw - 64rem) / 2 - 8.5rem));
    width: 7.25rem;
    transform: translateY(-50%);
  }

  .resume-section-label {
    margin-bottom: 0.75rem;
    color: var(--color-ink-soft);
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .resume-section-rail ol {
    border-left: 1px solid var(--color-line);
  }

  .resume-section-rail a {
    position: relative;
    display: block;
    padding: 0.4rem 0 0.4rem 0.75rem;
    color: var(--color-ink-soft);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    line-height: 1.35;
    transition: color 180ms ease;
  }

  .resume-section-rail a::before {
    position: absolute;
    top: 0;
    bottom: 0;
    left: -1px;
    width: 2px;
    background: transparent;
    content: '';
  }

  .resume-section-rail a:hover,
  .resume-section-rail a[aria-current='location'] {
    color: var(--color-signal);
  }

  .resume-section-rail a[aria-current='location']::before {
    background: var(--color-signal);
  }

  .resume-section-menu {
    display: none;
  }

  .resume-page [id^='resume-'] {
    scroll-margin-top: 7rem;
  }

  .resume-role {
    position: relative;
    transition: border-color 180ms ease, box-shadow 180ms ease;
  }

  .resume-role:hover {
    border-color: color-mix(in srgb, var(--color-signal) 48%, var(--color-line));
  }

  .resume-role-featured {
    border-left: 3px solid var(--color-signal);
    box-shadow: 0 8px 28px color-mix(in srgb, var(--color-signal) 9%, transparent);
  }

  .resume-date {
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-signal) 9%, var(--color-surface));
    padding: 0.4rem 0.65rem;
  }

  .resume-education {
    background: color-mix(in srgb, var(--color-signal) 4%, var(--color-surface));
  }

  .resume-credential {
    border-top: 2px solid color-mix(in srgb, var(--color-signal) 42%, var(--color-line));
    transition: border-color 180ms ease, box-shadow 180ms ease;
  }

  .resume-credential:hover {
    border-color: color-mix(in srgb, var(--color-signal) 58%, var(--color-line));
    box-shadow: 0 8px 24px color-mix(in srgb, var(--color-signal) 8%, transparent);
  }

  .resume-credential-mark {
    background: color-mix(in srgb, var(--color-signal) 10%, var(--color-surface));
    color: var(--color-signal);
  }

  :global(html:has(.resume-page)) {
    scrollbar-color: color-mix(in srgb, var(--color-signal) 62%, var(--color-line))
      var(--color-paper);
    scrollbar-width: thin;
    scroll-behavior: smooth;
  }

  :global(html:has(.resume-page)::-webkit-scrollbar) {
    width: 0.75rem;
  }

  :global(html:has(.resume-page)::-webkit-scrollbar-track) {
    background: var(--color-paper);
  }

  :global(html:has(.resume-page)::-webkit-scrollbar-thumb) {
    border: 3px solid var(--color-paper);
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-signal) 42%, var(--color-line));
  }

  :global(html:has(.resume-page)::-webkit-scrollbar-thumb:hover) {
    background: var(--color-signal);
  }

  @media (min-width: 80rem) {
    .resume-section-menu {
      display: none;
    }
  }

  @media (max-width: 79.999rem) {
    .resume-section-rail {
      display: none;
    }

    .resume-section-menu {
      display: block;
      position: sticky;
      z-index: 30;
      top: 5rem;
      margin: 1rem 0 0.75rem;
      border: 1px solid color-mix(in srgb, var(--color-signal) 42%, var(--color-line));
      border-left: 3px solid var(--color-signal);
      border-radius: 0.875rem;
      background: color-mix(in srgb, var(--color-surface) 90%, var(--color-signal));
      box-shadow: 0 10px 26px color-mix(in srgb, var(--color-ink) 12%, transparent);
      backdrop-filter: blur(12px);
    }

    .resume-section-menu summary {
      display: flex;
      min-height: 2.75rem;
      align-items: center;
      gap: 0.65rem;
      padding: 0.65rem 0.9rem;
      color: var(--color-ink-soft);
      cursor: pointer;
      font-family: var(--font-mono);
      font-size: 0.6875rem;
      letter-spacing: 0.08em;
      list-style: none;
      text-transform: uppercase;
    }

    .resume-section-menu summary::-webkit-details-marker {
      display: none;
    }

    .resume-section-menu summary span:first-child {
      border-radius: 0.35rem;
      background: color-mix(in srgb, var(--color-signal) 12%, var(--color-surface));
      padding: 0.25rem 0.4rem;
      color: var(--color-signal);
    }

    .resume-section-menu summary span:nth-child(2) {
      color: var(--color-signal);
      font-weight: 600;
    }

    .resume-section-menu summary svg {
      width: 1rem;
      height: 1rem;
      margin-left: auto;
      stroke: currentColor;
      stroke-linecap: round;
      stroke-linejoin: round;
      stroke-width: 1.5;
      transition: transform 180ms ease;
    }

    .resume-section-menu[open] summary svg {
      transform: rotate(180deg);
    }

    .resume-section-menu nav {
      border-top: 1px solid var(--color-line);
      padding: 0.5rem;
    }

    .resume-section-menu ol {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.25rem;
    }

    .resume-section-menu a {
      display: block;
      border-radius: 0.5rem;
      padding: 0.65rem 0.7rem;
      color: var(--color-ink-soft);
      font-family: var(--font-mono);
      font-size: 0.6875rem;
      transition:
        background-color 180ms ease,
        color 180ms ease;
    }

    .resume-section-menu a:hover,
    .resume-section-menu a[aria-current='location'] {
      background: color-mix(in srgb, var(--color-signal) 10%, var(--color-surface));
      color: var(--color-signal);
    }

    .resume-page [id^='resume-'] {
      scroll-margin-top: 8rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html:has(.resume-page)) {
      scroll-behavior: auto;
    }

    .resume-role,
    .resume-section-menu summary svg {
      transition: none;
    }
  }
</style>

<script>
  let activeSectionFrame = 0;
  let cleanupResumeSidebar = () => {};

  function initResumeSidebar() {
    cleanupResumeSidebar();

    const sectionLinks = Array.from(
      document.querySelectorAll<HTMLAnchorElement>('.resume-page [data-section-link]'),
    );
    const sections = Array.from(
      new Set(
        sectionLinks
          .map((link) => document.getElementById(link.dataset.sectionLink ?? ''))
          .filter((section): section is HTMLElement => section instanceof HTMLElement),
      ),
    );
    const currentSectionLabels = document.querySelectorAll<HTMLElement>(
      '[data-current-section]',
    );
    const mobileSectionMenu = document.querySelector<HTMLDetailsElement>(
      '.resume-section-menu',
    );

    if (!sectionLinks.length || !sections.length) return;

    function updateActiveSection() {
      if (activeSectionFrame) return;

      activeSectionFrame = window.requestAnimationFrame(() => {
        const marker = window.innerHeight * 0.32;
        let activeSection = sections[0];

        sections.forEach((section) => {
          if (section.getBoundingClientRect().top <= marker) activeSection = section;
        });

        if (window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2) {
          activeSection = sections[sections.length - 1];
        }

        if (activeSection) {
          sectionLinks.forEach((link) => {
            if (link.dataset.sectionLink === activeSection?.id) {
              link.setAttribute('aria-current', 'location');
            } else {
              link.removeAttribute('aria-current');
            }
          });

          const label = sectionLinks.find(
            (link) => link.dataset.sectionLink === activeSection?.id,
          )?.dataset.sectionLabel;
          if (label) currentSectionLabels.forEach((element) => (element.textContent = label));
        }

        activeSectionFrame = 0;
      });
    }

    const mobileSectionLinks = Array.from(
      mobileSectionMenu?.querySelectorAll<HTMLAnchorElement>('a') ?? [],
    );
    const closeMobileMenu = () => {
      if (mobileSectionMenu) mobileSectionMenu.open = false;
    };

    mobileSectionLinks.forEach((link) => {
      link.addEventListener('click', closeMobileMenu);
    });
    window.addEventListener('scroll', updateActiveSection, { passive: true });
    window.addEventListener('resize', updateActiveSection);

    cleanupResumeSidebar = () => {
      window.removeEventListener('scroll', updateActiveSection);
      window.removeEventListener('resize', updateActiveSection);
      mobileSectionLinks.forEach((link) => {
        link.removeEventListener('click', closeMobileMenu);
      });
      if (activeSectionFrame) window.cancelAnimationFrame(activeSectionFrame);
      activeSectionFrame = 0;
      cleanupResumeSidebar = () => {};
    };

    updateActiveSection();
  }

  function cleanupBeforeSwap() {
    cleanupResumeSidebar();
  }

  initResumeSidebar();
  document.addEventListener('astro:page-load', initResumeSidebar);
  document.addEventListener('astro:before-swap', cleanupBeforeSwap);
</script>
