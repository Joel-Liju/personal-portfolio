---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/Button.astro';
import WorkRow from '@/components/WorkRow.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import StatusPill from '../components/StatusPill.astro';
import { SITE } from '@/site.config';

const allWork = await getCollection('work', ({ data }) => !data.draft);
const sorted = [...allWork].sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const featured = sorted.filter((entry) => entry.data.featured);
const rest = sorted.filter((entry) => !entry.data.featured);
const selected = [...featured, ...rest].slice(0, 5);
---

<BaseLayout title={SITE.name}>
  <div class="home-page">
    <section class="home-hero mx-auto grid max-w-5xl items-center gap-10 px-6 pt-12 pb-20 sm:pt-16 lg:grid-cols-[minmax(0,1fr)_19rem] lg:gap-16">
      <div>
        <p class="hero-enter text-ink-soft mb-6 inline-flex items-center gap-2 font-mono text-xs">
          <StatusPill />
        </p>

        <h1 class="hero-enter hero-title font-display text-ink max-w-4xl text-6xl leading-none font-medium sm:text-8xl">
          A <span class="tagline-wavy inline-block transition-transform duration-300 ease-out hover:-translate-y-1 hover:decoration-signal/80 underline decoration-signal decoration-wavy decoration-2 underline-offset-4 cursor-pointer"><a href="/work">problem-solver</a></span> and a <span class="tagline-dotted inline-block transition-all duration-300 ease-out hover:decoration-ink hover:tracking-wide underline decoration-ink/40 decoration-dotted decoration-2 underline-offset-4 cursor-pointer"><a href="/hobbies">chef</a></span>.
        </h1>

        <p class="hero-enter hero-copy text-ink-soft mt-6 max-w-md">
          {SITE.role}
        </p>

        <div class="hero-enter hero-actions mt-8 flex flex-wrap items-center gap-3">
          <Button href="/work" variant="solid">View the work →</Button>
          <Button href="/contact" variant="accent">Say hello ↗</Button>
        </div>
      </div>

      <img
        src="/Me.jpeg"
        alt="Joel wearing a blue suit outdoors"
        class="hero-enter hero-portrait border-line mx-auto aspect-[4/5] w-full max-w-[19rem] rounded-[2rem] border object-cover object-center shadow-xl lg:rotate-2"
        width="727"
        height="1024"
        fetchpriority="high"
        decoding="async"
      />
    </section>

    <section id="work" class="mx-auto max-w-5xl px-6 pb-20">
      <div data-reveal>
        <SectionHeading eyebrow="Selected work" count={allWork.length} />
      </div>
      <div>
        {selected.map((entry, index) => (
          <div data-reveal style={`--reveal-delay: ${Math.min(index, 3) * 70}ms`}>
            <WorkRow entry={entry} />
          </div>
        ))}
      </div>
      {
        allWork.length > selected.length && (
          <div data-reveal class="mt-6">
            <a
              href="/work"
              class="text-ink-soft hover:text-signal font-mono text-xs transition-colors"
            >
              View all {allWork.length} projects →
            </a>
          </div>
        )
      }
    </section>

    <section id="about" class="mx-auto max-w-5xl px-6 pb-20">
      <div data-reveal>
        <SectionHeading eyebrow="About" />
      </div>
      <p data-reveal class="text-ink-soft max-w-xl">
        I'm Joel Liju Jacob — a software engineer who sometimes wonders if he should have been a chef. I love to cook and I love to code; both are problem-solving, and I'm drawn to elegant solutions to complex ones. I write about both to clarify my thinking and share what I learn.
      </p>
      <a data-reveal href="/about" class="text-signal mt-4 inline-block font-mono text-xs hover:underline">
        More about how I work →
      </a>
    </section>

    <section id="contact" class="mx-auto max-w-5xl px-6 pb-24">
      <div data-reveal>
        <SectionHeading eyebrow="Let's talk" />
      </div>
      <p data-reveal class="font-display text-ink max-w-lg text-2xl sm:text-3xl">
        Looking for a software engineer? Let’s talk.
      </p>
      <a
        data-reveal
        href="/contact"
        class="text-signal mt-4 inline-flex items-center gap-2 font-mono hover:underline"
      >
        Contact me →
      </a>
    </section>
  </div>
</BaseLayout>

<style>
  @keyframes gentle-rise {
    from {
      opacity: 0;
      transform: translateY(0.75rem);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .hero-enter {
    opacity: 0;
    animation: gentle-rise 700ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .hero-title {
    animation-delay: 100ms;
  }

  .hero-copy {
    animation-delay: 180ms;
  }

  .hero-actions {
    animation-delay: 260ms;
  }

  .hero-portrait {
    animation-delay: 340ms;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-enter {
      opacity: 1;
      animation: none;
    }

  }
</style>
