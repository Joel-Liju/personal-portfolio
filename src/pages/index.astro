---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/Button.astro';
import WorkRow from '@/components/WorkRow.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import StatusPill from '../components/StatusPill.astro';
import { SITE } from '@/site.config';

const allWork = await getCollection('work', ({ data }) => !data.draft);
const sorted = [...allWork].sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const featured = sorted.filter((entry) => entry.data.featured);
const rest = sorted.filter((entry) => !entry.data.featured);
const selected = [...featured, ...rest].slice(0, 5);
---

<BaseLayout title={SITE.name}>
  <section class="mx-auto max-w-5xl px-6 pt-16 pb-20 sm:pt-18">
    <p class="text-ink-soft mb-6 inline-flex items-center gap-2 font-mono text-xs">
      <StatusPill />
    </p>

    <h1 class="font-display text-ink max-w-4xl text-6xl leading-none font-medium sm:text-8xl">
      A <span class="tagline-wavy inline-block transition-transform duration-300 ease-out hover:-translate-y-1 hover:decoration-signal/80 underline decoration-signal decoration-wavy decoration-2 underline-offset-4 cursor-pointer"><a href="/work">problem-solver</a></span> and <span class="tagline-dotted inline-block transition-all duration-300 ease-out hover:decoration-ink hover:tracking-wide underline decoration-ink/40 decoration-dotted decoration-2 underline-offset-4 cursor-pointer"><a href="/about">cooker</a></span> of food.
    </h1>

    <p class="text-ink-soft mt-6 max-w-md">
      {SITE.role} 
    </p>

    <div class="mt-8 flex flex-wrap items-center gap-3">
      <Button href="/work" variant="solid">View the work →</Button>
      <Button href="#contact" variant="ghost">Say hello</Button>
    </div>
  </section>

  <section id="work" class="mx-auto max-w-5xl px-6 pb-20">
    <SectionHeading eyebrow="Selected work" count={allWork.length} />
    <div>
      {selected.map((entry) => <WorkRow entry={entry} />)}
    </div>
    {
      allWork.length > selected.length && (
        <div class="mt-6">
          <a
            href="/work"
            class="text-ink-soft hover:text-signal font-mono text-xs transition-colors"
          >
            View all {allWork.length} projects →
          </a>
        </div>
      )
    }
  </section>

  <section id="about" class="mx-auto max-w-5xl px-6 pb-20">
    <SectionHeading eyebrow="About" />
    <p class="text-ink-soft max-w-xl">
      {SITE.description}
    </p>
    <a href="/about" class="text-signal mt-4 inline-block font-mono text-xs hover:underline">
      More about how I work →
    </a>
  </section>

  <section id="contact" class="mx-auto max-w-5xl px-6 pb-24">
    <SectionHeading eyebrow="Let's talk" />
    <p class="font-display text-ink max-w-lg text-2xl sm:text-3xl">
      Have something worth building?
    </p>
    <a
      href={`mailto:${SITE.email}`}
      class="text-signal mt-4 inline-flex items-center gap-2 font-mono hover:underline"
    >
      {SITE.email}
    </a>
  </section>
</BaseLayout>

<style>
  /* Entrance fade-in animation for initial page load */
  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(4px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fade-in {
    animation: fadeIn 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards 0.2s;
  }

  /* Wavy underline sliding effect on hover */
  @keyframes waveMove {
    0% {
      background-position-x: 0;
    }
    100% {
      background-position-x: 20px;
    }
  }

  .animated-wavy {
    /* Page load entry */
    animation: fadeIn 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .animated-wavy:hover {
    /* Subtle background shimmer movement along the wavy line */
    animation: waveMove 1s linear infinite;
  }
</style>